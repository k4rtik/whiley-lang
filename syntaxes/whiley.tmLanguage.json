{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Whiley",
    "scopeName": "source.whiley",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#package-declaration"
        },
        {
            "include": "#import-declaration"
        },
        {
            "include": "#function-declaration"
        },
        {
            "include": "#type-declaration"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#function-call"
        },
        {
            "include": "#constants"
        },
        {
            "include": "#types"
        },
        {
            "include": "#namespaces"
        },
        {
            "include": "#punctuation"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#variables"
        }
    ],
    "repository": {
        "constants": {
            "patterns": [
                {
                    "name": "constant.other.caps.whiley",
                    "match": "\\b_?[A-Z][A-Z0-9_]+\\b"
                },
                {
                    "name": "constant.numeric.whiley",
                    "match": "\\b\\d[\\d_]*(\\.?)[\\d_]*\\b",
                    "captures": {
                        "1": {
                            "name": "punctuation.separator.dot.decimal.whiley"
                        }
                    }
                },
                {
                    "name": "constant.numeric.hex.whiley",
                    "match": "\\b0x[\\da-fA-F_]*\\b",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.numeric.whiley"
                        }
                    }
                },
                {
                    "name": "constant.numeric.oct.whiley",
                    "match": "\\b0o[0-7_]*\\b",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.numeric.whiley"
                        }
                    }
                },
                {
                    "name": "constant.numeric.bin.whiley",
                    "match": "\\b0b[01_]*\\b",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.numeric.whiley"
                        }
                    }
                },
                {
                    "name": "constant.language.bool.whiley",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.whiley",
                    "match": "(//).*$",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.comment.whiley"
                        }
                    }
                },
                {
                    "name": "comment.block.documentation.whiley",
                    "begin": "/\\*\\*",
                    "end": "\\*/"
                },
                {
                    "name": "comment.block.whiley",
                    "begin": "/\\*(?!\\*)",
                    "end": "\\*/"
                }
            ]
        },
        "escapes": {
            "name": "constant.character.escape.whiley",
            "match": "\\\\."
        },
        "expression": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#keywords"
                },
                {
                    "include": "#function-call"
                },
                {
                    "include": "#constants"
                },
                {
                    "include": "#types"
                },
                {
                    "include": "#namespaces"
                },
                {
                    "include": "#punctuation"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#variables"
                }
            ]
        },
        "function-call": {
            "patterns": [
                {
                    "name": "meta.function-call.whiley",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.function.whiley"
                        }
                    }
                },
                {
                    "name": "meta.function-call.whiley",
                    "begin": "(?=([a-zA-Z_][a-zA-Z0-9_]*)\\s*(<(([a-zA-Z0-9_]*|[,])*)>)\\s*\\()",
                    "end": "(?<=\\))",
                    "patterns": [
                        {
                            "name": "entity.name.function.whiley",
                            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*<)"
                        },
                        {
                            "include": "#type-angles"
                        },
                        {
                            "begin": "\\(",
                            "beginCaptures": {
                                "0": {
                                    "name": "punctuation.brackets.round.whiley"
                                }
                            },
                            "end": "\\)",
                            "endCaptures": {
                                "0": {
                                    "name": "punctuation.brackets.round.whiley"
                                }
                            },
                            "patterns": [
                                {
                                    "include": "#expression"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        "function-declaration": {
            "name": "meta.function.whiley",
            "begin": "\\b(function|method|property|variant)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*",
            "beginCaptures": {
                "1": {
                    "name": "keyword.other.${1:/downcase}.whiley"
                },
                "2": {
                    "name": "entity.name.function.whiley"
                }
            },
            "end": "(:|(?=^\\s*(?=\\n)))",
            "endCaptures": {
                "1": {
                    "name": "punctuation.section.function.begin.whiley"
                }
            },
            "patterns": [
                {
                    "include": "#type-angles"
                },
                {
                    "include": "#function-parameters"
                },
                {
                    "include": "#function-return-type"
                },
                {
                    "include": "#comments"
                },
                {
                    "name": "meta.ensures-requires.whiley",
                    "begin": "\\b(ensures|requires)\\s+(?=\\S)",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.control.${1:/downcase}.whiley"
                        }
                    },
                    "end": "(?=:|$|\\n)",
                    "patterns": [
                        {
                            "include": "#expression"
                        }
                    ]
                }
            ]
        },
        "function-parameters": {
            "name": "meta.function-parameters.whiley",
            "begin": "\\(",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.definition.parameters.begin.whiley"
                }
            },
            "end": "\\)",
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.parameters.end.whiley"
                }
            },
            "patterns": [
                {
                    "include": "#keywords"
                },
                {
                    "include": "#type-function"
                },
                {
                    "include": "#constants"
                },
                {
                    "include": "#types"
                },
                {
                    "include": "#namespaces"
                },
                {
                    "include": "#punctuation"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#variables"
                }
            ]
        },
        "function-return-type": {
            "begin": "\\s*(->)\\s*",
            "beginCaptures": {
                "1": {
                    "name": "keyword.operator.return-type.whiley"
                }
            },
            "end": "(?<=\\))|(?=[:,]|\\s)",
            "patterns": [
                {
                    "include": "#type-paren"
                },
                {
                    "include": "#types"
                }
            ]
        },
        "import-declaration": {
            "name": "meta.import.whiley",
            "begin": "^(import)\\s+(?=([a-zA-Z_0-9]+|\\*))",
            "beginCaptures": {
                "1": {
                    "name": "keyword.other.import.whiley"
                }
            },
            "end": "(?=$|\\n)",
            "patterns": [
                {
                    "name": "keyword.other.import-all.whiley",
                    "match": "\\*"
                },
                {
                    "include": "#namespaces"
                },
                {
                    "include": "#types"
                },
                {
                    "include": "#punctuation-comma"
                },
                {
                    "name": "keyword.other.import.from.whiley",
                    "match": "\\b(from)\\b"
                },
                {
                    "name": "keyword.other.import.with.whiley",
                    "match": "\\b(with)\\b"
                },
                {
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
                    "name": "variable.other.whiley"
                },
                {
                    "include": "#comments"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.whiley",
                    "match": "\\b(assert|assume|break|case|continue|debug|default|do|else|ensures|fail|for|if|requires|return|skip|switch|where|while)\\b"
                },
                {
                    "name": "keyword.operator.word.whiley",
                    "match": "\\b(all|in|is|new|no|old|some)\\b"
                },
                {
                    "name": "keyword.other.whiley",
                    "match": "\\b(export|final|native|private|protected|public|unsafe|void)\\b"
                },
                {
                    "begin": "(?=\\|[a-zA-Z0-9_.]+\\|)",
                    "end": "(?<=\\|)",
                    "patterns": [
                        {
                            "begin": "\\|",
                            "beginCaptures": {
                                "0": {
                                    "name": "punctuation.bar.array-length.whiley"
                                }
                            },
                            "end": "\\|",
                            "endCaptures": {
                                "0": {
                                    "name": "punctuation.bar.array-length.whiley"
                                }
                            },
                            "patterns": [
                                {
                                    "include": "#variables"
                                },
                                {
                                    "name": "keyword.operator.access.dot.whiley",
                                    "match": "\\.(?!\\.)"
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "keyword.operator.logical.whiley",
                    "match": "(&&|\\|\\||!(?!=)|==>|<==>)"
                },
                {
                    "name": "keyword.operator.borrow.and.whiley",
                    "match": "&(?!&)"
                },
                {
                    "name": "keyword.operator.assignment.equal.whiley",
                    "match": "(?<![<>])=(?!=|>)"
                },
                {
                    "name": "keyword.operator.arithmetic.whiley",
                    "match": "(<=|<|>=|>|==|!=|[+%]|(-(?!>))|\\*|/)"
                },
                {
                    "name": "keyword.operator.namespace.whiley",
                    "match": "::"
                },
                {
                    "name": "keyword.operator.access.dot.whiley",
                    "match": "\\.(?!\\.)"
                },
                {
                    "name": "keyword.operator.range.whiley",
                    "match": "\\.{2}(?!\\.)"
                },
                {
                    "name": "keyword.operator.arrow.whiley",
                    "match": "->"
                }
            ]
        },
        "namespaces": {
            "patterns": [
                {
                    "comment": "namespace (non-type, non-function path segment)",
                    "match": "(?<![a-zA-Z0-9_])([a-zA-Z0-9_]+)(::)",
                    "captures": {
                        "1": {
                            "name": "entity.name.namespace.whiley"
                        },
                        "2": {
                            "name": "keyword.operator.namespace.whiley"
                        }
                    }
                }
            ]
        },
        "package-declaration": {
            "name": "meta.package.whiley",
            "begin": "^(package)\\s+(?=[a-zA-Z_0-9]+)",
            "beginCaptures": {
                "1": {
                    "name": "keyword.other.package.whiley"
                }
            },
            "end": "(?=$|\\n)",
            "patterns": [
                {
                    "include": "#namespaces"
                },
                {
                    "include": "#types"
                },
                {
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
                    "name": "variable.other.whiley"
                },
                {
                    "include": "#comments"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.comma.whiley",
                    "match": ","
                },
                {
                    "name": "punctuation.brackets.curly.whiley",
                    "match": "[{}]"
                },
                {
                    "name": "punctuation.brackets.round.whiley",
                    "match": "[()]"
                },
                {
                    "name": "punctuation.colon.whiley",
                    "match": ":"
                },
                {
                    "name": "punctuation.semi.whiley",
                    "match": ";"
                },
                {
                    "name": "punctuation.brackets.square.whiley",
                    "match": "[\\[\\]]"
                }
            ]
        },
        "punctuation-comma": {
            "name": "punctuation.comma.whiley",
            "match": ","
        },
        "strings": {
            "patterns": [
                {
                    "comment": "double-quoted strings",
                    "name": "string.quoted.double.whiley",
                    "begin": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.whiley"
                        }
                    },
                    "end": "\"",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.whiley"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#escapes"
                        }
                    ]
                },
                {
                    "comment": "single-quoted characters",
                    "name": "string.quoted.single.char.whiley",
                    "begin": "'",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.char.whiley"
                        }
                    },
                    "end": "'",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.char.whiley"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#escapes"
                        }
                    ]
                }
            ]
        },
        "type-declaration": {
            "name": "meta.type.whiley",
            "begin": "\\b(type)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?![a-zA-Z0-9_])",
            "beginCaptures": {
                "1": {
                    "name": "keyword.other.type.whiley"
                },
                "2": {
                    "name": "entity.name.type.whiley"
                }
            },
            "end": "(?=^\\s*(?!//|/\\*|where))",
            "patterns": [
                {
                    "include": "#type-angles"
                },
                {
                    "begin": "\\b(is)\\s+",
                    "beginCaptures": {
                        "1": {
                            "name": "keyword.operator.word.is.whiley"
                        }
                    },
                    "end": "((?<=\\})|(?=\\s*where)|$)",
                    "patterns": [
                        {
                            "include": "#type-record"
                        },
                        {
                            "include": "#type-paren"
                        },
                        {
                            "include": "#type-function"
                        },
                        {
                            "include": "#types"
                        }
                    ]
                },
                {
                    "include": "#comments"
                },
                {
                    "include": "#where-clause"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "match": "\\b(i8|i16|i32|u8|u16|u32|uint|nat)\\b",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.numeric.whiley"
                        }
                    }
                },
                {
                    "begin": "\\b(_?[A-Z][a-zA-Z0-9_]*)(<)",
                    "beginCaptures": {
                        "1": {
                            "name": "entity.name.type.whiley"
                        },
                        "2": {
                            "name": "punctuation.brackets.angle.whiley"
                        }
                    },
                    "end": ">",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.brackets.angle.whiley"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#comments"
                        },
                        {
                            "include": "#keywords"
                        },
                        {
                            "include": "#punctuation"
                        },
                        {
                            "include": "#types"
                        },
                        {
                            "include": "#variables"
                        }
                    ]
                },
                {
                    "name": "entity.name.type.primitive.whiley",
                    "match": "\\b(void|null|bool|byte|int|real|char|letter|uppercase|lowercase|digit|string|rwMode|integer|uinteger|number)\\b"
                },
                {
                    "name": "entity.name.type.whiley",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*_t\\b"
                },
                {
                    "name": "entity.name.type.whiley",
                    "match": "\\b_?[A-Z][a-zA-Z0-9_]*\\b"
                },
                {
                    "name": "punctuation.separator.pipe.whiley",
                    "match": "\\|(?!\\|)"
                },
                {
                    "begin": "(?<![a-zA-Z0-9_])([a-zA-Z_][a-zA-Z0-9_]*)(<)",
                    "beginCaptures": {
                        "1": {
                            "name": "entity.name.function.type.whiley"
                        },
                        "2": {
                            "name": "punctuation.brackets.angle.whiley"
                        }
                    },
                    "end": ">",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.brackets.angle.whiley"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#comments"
                        },
                        {
                            "include": "#keywords"
                        },
                        {
                            "include": "#punctuation"
                        },
                        {
                            "include": "#types"
                        },
                        {
                            "include": "#variables"
                        }
                    ]
                }
            ]
        },
        "type-paren": {
            "name": "meta.paren.type.whiley",
            "begin": "\\(",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.brackets.round.whiley"
                }
            },
            "end": "\\)",
            "endCaptures": {
                "0": {
                    "name": "punctuation.brackets.round.whiley"
                }
            },
            "patterns": [
                {
                    "include": "#type-record"
                },
                {
                    "include": "#types"
                },
                {
                    "include": "#punctuation-comma"
                },
                {
                    "include": "#variables"
                }
            ]
        },
        "type-record": {
            "name": "meta.record.type.whiley",
            "begin": "(&(?!&))?(\\{)",
            "beginCaptures": {
                "1": {
                    "name": "keyword.operator.borrow.whiley"
                },
                "2": {
                    "name": "punctuation.definition.block.whiley"
                }
            },
            "end": "\\}",
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.block.whiley"
                }
            },
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#keywords"
                },
                {
                    "include": "#type-function"
                },
                {
                    "include": "#constants"
                },
                {
                    "include": "#types"
                },
                {
                    "include": "#namespaces"
                },
                {
                    "include": "#punctuation"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#variables"
                },
                {
                    "name": "keyword.operator.record.whiley",
                    "match": "\\.{3}(?!\\.)"
                }
            ]
        },
        "type-angles": {
            "name": "meta.type-angles.whiley",
            "begin": "<",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.brackets.angle.whiley"
                }
            },
            "end": ">",
            "endCaptures": {
                "0": {
                    "name": "punctuation.brackets.angle.whiley"
                }
            },
            "patterns": [
                {
                    "include": "#types"
                },
                {
                    "include": "#punctuation-comma"
                }
            ]
        },
        "type-function": {
            "name": "meta.type-function.whiley",
            "begin": "\\b(?:(?:(function|method|property|variant)\\s*(?=\\())|(?:(function|method|property|variant)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*))",
            "beginCaptures": {
                "1": {
                    "name": "entity.name.${1:/downcase}.whiley"
                },
                "2": {
                    "name": "keyword.other.${1:/downcase}.whiley"
                },
                "3": {
                    "name": "entity.name.function.whiley"
                }
            },
            "end": "(?<=[}])|(?=\\s*(,|[.]{3}|\\s*(?=\\w)|$))",
            "patterns": [
                {
                    "include": "#type-angles"
                },
                {
                    "include": "#function-parameters"
                },
                {
                    "include": "#function-return-type"
                }
            ]
        },
        "variables": {
            "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
            "name": "variable.other.whiley"
        },
        "where-clause": {
            "name": "meta.where.whiley",
            "begin": "\\b(where)(?!\\.)",
            "beginCaptures": {
                "1": {
                    "name": "keyword.control.where.whiley"
                }
            },
            "end": "(?=$|:|\\n)",
            "patterns": [
                {
                    "include": "#expression"
                }
            ]
        }
    },
    "uuid": "5ee71b5b-00f0-4a98-904e-fccb7a06569f"
