{
    "comments": {
        // symbol used for single line comment.
        "lineComment": "//",
        // symbols used for start and end a block comment.
        "blockComment": ["/*", "*/"]
    },
    // symbols used as brackets
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    // symbols that are auto closed when typing
    "autoClosingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    // symbols that can be used to surround a selection
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    "folding": {
        "offSide": true,
        "markers": {
            "start": "^\\s*//\\s*region\\b",
            "end": "^\\s*//\\s*endregion\\b"
        }
    },
    "onEnterRules": [
        {
            "beforeText": "^\\s*(?:function|method|property|ensures|requires|for|if|else if|else|do|while|switch|case).*?:\\s*$",
            "action": {
                "indent": "indent"
            }
        }
    ]
}
